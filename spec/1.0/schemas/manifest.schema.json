{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Open-Dot-Agents/Agents-Spec/v1.0.0/spec/1.0/schemas/manifest.schema.json",
  "title": "Open-Dot-Agents 1.0 manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "version": {
      "const": "1.0.0"
    },
    "requires": {
      "$ref": "#/$defs/capabilities"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profileName"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "profileName": {
      "type": "string",
      "enum": [
        "tools",
        "skills"
      ]
    },
    "capability": {
      "type": "string",
      "enum": [
        "instructions",
        "instructions.scoped",
        "skills",
        "mcp.stdio",
        "mcp.remote",
        "mcp.envRef"
      ]
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      },
      "uniqueItems": true
    }
  }
}
