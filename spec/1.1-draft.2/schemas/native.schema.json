{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:open-dot-agents:draft:1.1.2:native",
  "title": "Native profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "harness_version",
    "scope",
    "required",
    "artifacts"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "harness_version": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "enum": [
        "project",
        "user"
      ]
    },
    "required": {
      "type": "boolean"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "source"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "description": "Adapter registry artifact kind. Copilot project agent-instructions preserves a fixed native Markdown instruction location; unknown optional kinds remain inactive.",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.@+-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.@+-]+)*$",
            "description": "Namespace-relative regular source file. Registered canonical-instructions bindings use the fixed AGENTS.md source from the portable core instead: Copilot project scope, or Codex and Copilot user scope."
          },
          "name": {
            "type": "string",
            "description": "Registry selector, not an arbitrary output path. Copilot project agent-instructions registers AGENTS.md, CLAUDE.md, .claude/CLAUDE.md, and GEMINI.md only.",
            "pattern": "^(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.@+-]+(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9_.@+-]+)*$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "namespace": {
            "enum": ["com.github.copilot", "com.openai.codex"]
          }
        },
        "required": [
          "namespace"
        ]
      },
      "then": {
        "properties": {
          "artifacts": {
            "items": {
              "if": {
                "properties": {
                  "kind": {
                    "const": "canonical-instructions"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "then": {
                "properties": {
                  "source": {
                    "const": "AGENTS.md"
                  }
                },
                "not": {
                  "required": [
                    "name"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
